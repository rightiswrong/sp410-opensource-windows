// Version resource for sp410-cli.exe - SPDX-License-Identifier: Apache-2.0
#include <winver.h>

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_NUM
PRODUCTVERSION  VERSION_NUM
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "sp410-opensource-windows contributors"
      VALUE "FileDescription",  "SP410 printer utility"
      VALUE "FileVersion",      VERSION_STR
      VALUE "InternalName",     "sp410-cli.exe"
      VALUE "LegalCopyright",   "Apache License 2.0"
      VALUE "OriginalFilename", "sp410-cli.exe"
      VALUE "ProductName",      "SP410 Open Driver for Windows"
      VALUE "ProductVersion",   VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
